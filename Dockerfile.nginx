FROM nginx:alpine

# Actualizar paquetes de Alpine a sus últimas versiones (parches de seguridad)
RUN apk upgrade --no-cache && \
    rm -rf /var/cache/apk/*

COPY nginx.conf /etc/nginx/nginx.conf

# El puerto interno (80) está definido en nginx.conf con `listen 80`.
# El mapeo al host lo define docker-compose.yml con `ports`.
# No se usa EXPOSE porque no aporta nada funcional en este setup.

CMD ["nginx", "-g", "daemon off;"]
